# Copia este archivo como .env y llena los valores. El archivo .env no se sube a Git.
# Solo las variables EXPO_PUBLIC_* llegan a la app; nunca pongas aquí llaves secretas
# (el access_token de Mercado Pago y la cuenta de servicio de Firebase van en backend/.env).

# Firebase: Configuración del proyecto > Tus apps > App web > Configuración
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = usar los emuladores locales (npm run emuladores) en lugar del proyecto real.
# Con el emulador, EXPO_PUBLIC_FIREBASE_PROJECT_ID debe ser demo-uberclone.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
# En un celular, "localhost" es el propio celular: usa la IP del computador (ej. 192.168.1.10).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# URL del backend de pagos (carpeta backend/), ej. http://192.168.1.10:3001
EXPO_PUBLIC_BACKEND_URL=

# Opcional: Google Directions. Sin esta llave la app usa OSRM (gratis).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opcional: Cloudinary (plan gratuito) para subir las fotos. Sin esto se guarda la ruta local.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
