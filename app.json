{
  "expo": {
    "name": "UberClone Conductor",
    "slug": "uberclone-conductor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "uberclone",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uberclone.conductor"
    },
    "android": {
      "package": "com.uberclone.conductor",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "UberClone Conductor necesita acceder a tus fotos para la foto de perfil y la foto del vehículo.",
          "cameraPermission": "UberClone Conductor necesita acceder a la cámara para tomar la foto de perfil y la foto del vehículo.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UberClone Conductor usa tu ubicación para mostrarte en el mapa y enviarte solicitudes mientras estás Disponible."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "trip-requests"
        }
      ]
    ]
  }
}
