# Copia este archivo como backend/.env. Nunca subas backend/.env ni la llave de la cuenta de servicio.
# Solo credenciales de PRUEBA durante todo el proyecto.

PORT=3001
# URL pública del backend (por ejemplo, la de ngrok). Con HTTPS, Mercado Pago usa regreso automático y webhook.
PUBLIC_BACKEND_URL=http://localhost:3001

# Mercado Pago: access token de PRUEBA de la cuenta vendedora (Tus integraciones > Credenciales de prueba)
MERCADOPAGO_ACCESS_TOKEN=

# Firebase Admin (proyecto real): Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
FIREBASE_PROJECT_ID=uberclone-dd7cc
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Para usar los emuladores locales en lugar del proyecto real, descomenta estas líneas
# y pon FIREBASE_PROJECT_ID=demo-uberclone:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
