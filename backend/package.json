{
  "name": "uberclone-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend de UberClone Conductor: pagos con Mercado Pago, despacho de solicitudes y simulador de pasajero.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "simular:viaje": "node --env-file-if-exists=.env scripts/simulatePassenger.js",
    "simular:cancelar": "node --env-file-if-exists=.env scripts/cancelTrip.js",
    "aprobar": "node --env-file-if-exists=.env scripts/approveDriver.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "mercadopago": "^3.6.1"
  }
}
